{
  "name": "keymaker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Keymaker 2 — apprendre Strudel et le solfège",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pi": "vite build --base=/keymaker/app/ --outDir dist-pi",
    "preview": "vite preview",
    "check": "node scripts/check-links.mjs && node scripts/check-content.mjs && node scripts/check-schemas.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "samples": "node scripts/build-sample-pack.mjs",
    "reference": "node scripts/build-reference.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "fuzz:schemas": "node scripts/fuzz-schemas.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
