<!doctype html>
<html lang="fr" data-theme="void">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Keymaker · Apparence — démo</title>
<link rel="stylesheet" href="keymaker-app/src/styles.css" />
<style>
  body { margin: 0; }
  .demo-wrap { max-width: 1200px; margin: 0 auto; padding: 26px clamp(16px,3vw,30px) 70px; }
  .demo-head h1 { font-family: var(--font-display); font-size: 28px; letter-spacing: -0.02em; margin: 6px 0 6px; color: var(--text); }
  .demo-head p { margin: 0 0 22px; color: var(--muted); font-size: 15px; max-width: 64ch; line-height: 1.5; }
  .demo-grid { display: grid; grid-template-columns: minmax(300px, 360px) 1fr; gap: 22px; align-items: start; }
  @media (max-width: 820px) { .demo-grid { grid-template-columns: 1fr; } }
  .demo-controls { padding: 20px 22px; border: 1px solid var(--hair); border-radius: 22px;
    background: linear-gradient(180deg, var(--bg-2), var(--bg)); box-shadow: inset 0 1px 0 var(--sheen), var(--amb-soft); position: relative; }
  .demo-preview { padding: 4px 2px; }
  .fake-cm { margin: 0; padding: 15px 17px; font-family: var(--font-mono); font-size: 15px; line-height: 1.7; color: var(--text); white-space: pre; }
  .fake-cm .fn { color: var(--accent); } .fake-cm .str { color: #34d399; }
</style>
</head>
<body>
<div class="app" data-theme="void">
  <div class="demo-wrap">
    <header class="demo-head">
      <p class="kicker">Réglages › Apparence</p>
      <h1>Pilote le design</h1>
      <p>Exactement le panneau intégré à l'app. Touche aux réglages — l'aperçu à droite réagit en direct (couleur, halo, fond, grain, lumière au curseur). C'est ce que tu retrouveras dans Réglages.</p>
    </header>
    <div class="demo-grid">
      <aside class="demo-controls">
        <section class="set-section">
          <h3 class="set-h">Thème</h3>
          <div class="set-seg" data-group="theme">
            <button class="set-seg-btn on" data-v="void">Void</button>
            <button class="set-seg-btn" data-v="light">Clair</button>
            <button class="set-seg-btn" data-v="matrix">Matrix</button>
          </div>
        </section>
        <section class="set-section">
          <h3 class="set-h">Personnalisation</h3>
          <div class="set-row set-row-col">
            <div class="set-row-label"><span class="set-name">Couleur d'accent</span><span class="set-desc">« Par thème » garde la couleur d'origine ; le dernier carré = libre.</span></div>
            <div class="set-swatches" id="swatches"></div>
          </div>
          <div class="set-row">
            <div class="set-row-label"><span class="set-name">Intensité du halo</span><span class="set-desc">Force des lueurs.</span></div>
            <div class="set-seg" data-group="halo">
              <button class="set-seg-btn" data-v="soft">Discret</button>
              <button class="set-seg-btn on" data-v="balanced">Équilibré</button>
              <button class="set-seg-btn" data-v="intense">Intense</button>
            </div>
          </div>
          <div class="set-row">
            <div class="set-row-label"><span class="set-name">Fond</span><span class="set-desc">Sombre seulement. « Noir pur » = OLED.</span></div>
            <div class="set-seg" data-group="bg">
              <button class="set-seg-btn on" data-v="auto">Profond</button>
              <button class="set-seg-btn" data-v="oled">Noir pur</button>
              <button class="set-seg-btn" data-v="soft">Adouci</button>
            </div>
          </div>
          <div class="set-row">
            <div class="set-row-label"><span class="set-name">Grain</span><span class="set-desc">Texture fine sur le fond.</span></div>
            <button class="set-toggle" id="t-grain" role="switch" aria-checked="false" aria-label="Grain"><span class="set-toggle-knob"></span></button>
          </div>
          <div class="set-row">
            <div class="set-row-label"><span class="set-name">Lumière au curseur</span><span class="set-desc">Une lueur qui suit la souris.</span></div>
            <button class="set-toggle" id="t-cursor" role="switch" aria-checked="false" aria-label="Lumière au curseur"><span class="set-toggle-knob"></span></button>
          </div>
        </section>
      </aside>

      <main class="demo-preview">
        <div class="wordmark"><span class="glyph" aria-hidden="true">&#42796;</span> Keymaker</div>
        <p class="kicker">Module 2 &middot; Le rythme</p>
        <h2 class="title" style="font-size:26px;margin:0 0 16px">Poser le premier battement</h2>
        <section class="card concept"><p style="margin:0">Un pattern, c'est une suite de sons dans le temps. <code>sound("bd hh sd hh")</code> en joue quatre par tour.</p></section>
        <section class="editor-block">
          <div class="editor-frame" id="ed" style="box-shadow: inset 0 1px 0 var(--sheen-strong), 0 0 0 1px rgba(var(--accent-rgb),0.30), 0 0 38px -10px var(--lume), var(--amb)">
            <div class="editor-host"><pre class="fake-cm"><span class="fn">sound</span>(<span class="str">"bd hh sd hh"</span>)\n  .<span class="fn">bank</span>(<span class="str">"RolandTR909"</span>)\n  .<span class="fn">gain</span>(0.9)</pre></div>
          </div>
          <div class="controls" style="margin-top:14px">
            <button class="btn run"><span class="btn-main">&#9654; Run</span><span class="btn-kbd">Ctrl + Enter</span></button>
            <button class="btn stop"><span class="btn-main">&#9632; Stop</span><span class="btn-kbd">Ctrl + .</span></button>
            <span class="status on"><span class="dot" aria-hidden="true"></span>en cours</span>
          </div>
        </section>
        <nav class="flash-nav">
          <button class="nav-btn prev">Précédent</button>
          <div class="progress"><div class="dots"><span class="dot-step done"></span><span class="dot-step done"></span><span class="dot-step done"></span><span class="dot-step current"></span><span class="dot-step"></span><span class="dot-step"></span></div><span class="count">4/6</span></div>
          <button class="nav-btn next">Suivant</button>
        </nav>
      </main>
    </div>
  </div>
</div>

<script>
var ACC = {
  cyan: ['#22d3ee','34, 211, 238','#04141a'], amber: ['#f5b73d','245, 183, 61','#241a02'],
  emerald: ['#33e6a6','51, 230, 166','#03241a'], violet: ['#a995ff','169, 149, 255','#160a2e'],
  rose: ['#fb7aa0','251, 122, 160','#2a0a16'], ice: ['#5fa8ff','95, 168, 255','#04122a']
};
var HALO = { soft:0.5, balanced:1, intense:1.7 };
var BG = { oled:['#000000','#06070d','rgba(0,0,0,0.86)'], soft:['#141a2c','#1c2540','rgba(20,26,44,0.85)'] };
var S = { theme:'void', accent:'auto', custom:'#22d3ee', halo:'balanced', bg:'auto', grain:false, cursor:false };
function hexToRgb(h){h=String(h).replace('#','');if(h.length===3)h=h.split('').map(function(c){return c+c}).join('');var n=parseInt(h,16);return ((n>>16)&255)+', '+((n>>8)&255)+', '+(n&255);}
function inkFor(rgb){var p=rgb.split(',').map(function(x){return parseInt(x,10)});var l=(0.299*p[0]+0.587*p[1]+0.114*p[2])/255;return l>0.6?'#0a0f1a':'#ffffff';}
function apply(){
  var el=document.documentElement;
  el.setAttribute('data-theme',S.theme); document.querySelector('.app').setAttribute('data-theme',S.theme);
  var a = S.accent==='auto'?null:(S.accent==='custom'?[S.custom,hexToRgb(S.custom),inkFor(hexToRgb(S.custom))]:ACC[S.accent]);
  if(a){el.style.setProperty('--accent',a[0]);el.style.setProperty('--accent-rgb',a[1]);el.style.setProperty('--accent-ink',a[2]);}
  else{el.style.removeProperty('--accent');el.style.removeProperty('--accent-rgb');el.style.removeProperty('--accent-ink');}
  el.style.setProperty('--glow-strength',String(HALO[S.halo]||1));
  var bp = (S.theme!=='light')?BG[S.bg]:null;
  if(bp){el.style.setProperty('--bg',bp[0]);el.style.setProperty('--bg-2',bp[1]);el.style.setProperty('--bg-fade',bp[2]);}
  else{el.style.removeProperty('--bg');el.style.removeProperty('--bg-2');el.style.removeProperty('--bg-fade');}
  el.classList.toggle('grain-on',S.grain); el.classList.toggle('spotlight-on',S.cursor);
}
// Swatches
var SW = [['auto','Par thème'],['cyan','Cyan'],['amber','Ambre'],['emerald','Émeraude'],['violet','Violet'],['rose','Rose'],['ice','Glacier']];
var box = document.getElementById('swatches');
SW.forEach(function(s){
  var b=document.createElement('button'); b.type='button'; b.title=s[1]; b.setAttribute('aria-label',s[1]);
  b.className='set-swatch'+(s[0]==='auto'?' set-swatch-auto':'')+(S.accent===s[0]?' on':'');
  if(s[0]!=='auto') b.style.setProperty('--sw',ACC[s[0]][0]);
  b.addEventListener('click',function(){S.accent=s[0];refreshSw();apply();});
  box.appendChild(b);
});
var lab=document.createElement('label'); lab.className='set-swatch set-swatch-custom'; lab.title='Personnalisé'; lab.style.setProperty('--sw',S.custom);
var inp=document.createElement('input'); inp.type='color'; inp.value=S.custom; inp.setAttribute('aria-label','Couleur personnalisée');
inp.addEventListener('input',function(){S.accent='custom';S.custom=inp.value;lab.style.setProperty('--sw',inp.value);refreshSw();apply();});
lab.appendChild(inp); box.appendChild(lab);
function refreshSw(){Array.prototype.forEach.call(box.children,function(c,i){ if(i<SW.length){c.classList.toggle('on',S.accent===SW[i][0]);} else {c.classList.toggle('on',S.accent==='custom');}});}
// Segmented groups
document.querySelectorAll('.set-seg[data-group]').forEach(function(g){
  g.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var k=g.getAttribute('data-group');S[k]=b.getAttribute('data-v');g.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b)});apply();});
});
// Toggles
function wireToggle(id,key){var t=document.getElementById(id);t.addEventListener('click',function(){S[key]=!S[key];t.classList.toggle('on',S[key]);t.setAttribute('aria-checked',S[key]?'true':'false');apply();});}
wireToggle('t-grain','grain'); wireToggle('t-cursor','cursor');
// Cursor light
window.addEventListener('pointermove',function(e){ if(!S.cursor)return; var el=document.documentElement; el.style.setProperty('--mx',e.clientX+'px'); el.style.setProperty('--my',e.clientY+'px'); },{passive:true});
apply();
</script>
</body>
</html>
